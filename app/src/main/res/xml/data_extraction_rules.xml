<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Fortschritt/Merkliste sichern, Absturzbericht und Zwischenspeicher nicht (nur Aufgeführtes wird gesichert). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="library.json" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="library.json" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
